@page
@model MamphoWebsite.Pages.BookingsModel
@{
    ViewData["Title"] = "All Bookings";
}

<div style="max-width:700px; margin:auto;">
    <h1 style="color:#d63384; text-align:center;">📋 All Bookings</h1>
    <p style="text-align:center;">Total bookings: @Model.AllBookings.Count</p>

    <div style="text-align:center; margin-bottom:20px;">
        <a href="/Book" style="background:#d63384; color:white; padding:10px 20px; border-radius:10px; text-decoration:none;">+ New Booking</a>
    </div>

    @if (Model.AllBookings.Count == 0)
    {
        <p style="text-align:center; background:#fff0f5; padding:30px; border-radius:15px;">No bookings yet. Be the first to book! 💅</p>
    }
    else
    {
        @foreach (var b in Model.AllBookings)
        {
            <div style="background:#fff0f5; padding:20px; border-radius:15px; margin-bottom:15px; border-left:5px solid #d63384;">
                <h3 style="margin:0;">@b.Name - @b.Service</h3>
                <p style="margin:5px 0;">📞 @b.Phone | 📅 @b.Date</p>
                <p style="margin:5px 0; color:#666;">📝 @b.Notes</p>
                <form method="post" asp-page-handler="Delete" style="margin-top:10px;">
                    <input type="hidden" name="id" value="@b.Id" />
                    <button type="submit" style="background:white; color:#d63384; border:1px solid #d63384; padding:6px 12px; border-radius:8px;">Cancel Booking ❌</button>
                </form>
            </div>
        }
    }
</div>